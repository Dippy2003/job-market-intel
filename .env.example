# Copy to .env and fill in. Never commit .env.
# Neon/Supabase connection string (sslmode=require for cloud Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional Gemini key. Leave blank to skip the skill-extraction LLM fallback.
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
# Fallback runs only when the matcher finds fewer skills than this.
LLM_MIN_SKILLS=2
SCRAPER_USER_AGENT=job-market-intel/0.1 (student research project; contact: you@example.com)
SCRAPER_MIN_DELAY=2.0
SCRAPER_MAX_DELAY=4.0
LOG_LEVEL=INFO
# Comma-separated browser origins for the read-only API. * allows any origin.
CORS_ORIGINS=*
# Streamlit dashboard. Base URL of the read-only API. Not a secret.
API_BASE_URL=http://127.0.0.1:8000
