# Copy to .env and fill in. Never commit .env.
# Neon/Supabase connection string (sslmode=require for cloud Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
